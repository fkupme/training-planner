{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "mobile",
	"description": "Permissions for mobile platforms",
	"windows": ["main_window"],
	"permissions": [
		"core:default",
		"notification:default",
		"notification:allow-is-permission-granted",
		"notification:allow-request-permission",
		"notification:allow-notify",
		"notification:allow-register-action-types",
		"notification:allow-register-listener",
		"sql:default",
		"sql:allow-load",
		"sql:allow-execute",
		"sql:allow-select",
		"sql:allow-close",
		"opener:default",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "http://localhost:*" },
				{ "url": "http://127.0.0.1:*" },
				{ "url": "http://192.168.*:*" },
				{ "url": "http://10.*:*" }
			]
		},
		{
			"identifier": "sql:default",
			"allow": [{ "database": "sqlite:training_planner.db" }]
		},
		"store:default",
		"store:allow-load",
		"store:allow-get",
		"store:allow-set",
		"store:allow-save",
		"store:allow-delete",
		"store:allow-clear",
		"store:allow-keys"
	]
}

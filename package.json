		"android:dev-local": "ANDROID_HOME=$HOME/Library/Android/sdk ANDROID_SDK_ROOT=$HOME/Library/Android/sdk ANDROID_NDK_HOME=$HOME/Library/Android/sdk/ndk/27.2.12479018 ANDROID_NDK_ROOT=$HOME/Library/Android/sdk/ndk/27.2.12479018 NDK_HOME=$HOME/Library/Android/sdk/ndk/27.2.12479018 tauri android dev",
		"android:build": "ANDROID_HOME=$HOME/Library/Android/sdk ANDROID_SDK_ROOT=$HOME/Library/Android/sdk ANDROID_NDK_HOME=$HOME/Library/Android/sdk/ndk/27.2.12479018 ANDROID_NDK_ROOT=$HOME/Library/Android/sdk/ndk/27.2.12479018 NDK_HOME=$HOME/Library/Android/sdk/ndk/27.2.12479018 tauri android build",
		"android:studio": "tauri android open",
		"android:uninstall": "adb uninstall com.tauri_app.training_planner || true",
